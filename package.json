{
  "name": "typed-evals",
  "version": "0.0.1",
  "description": "TypeScript evals: skeleton API, UI, and CLI.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "typed-evals": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "dist-ui"
  ],
  "scripts": {
    "build": "tsdown && vite build --config ui/vite.config.ts",
    "build:lib": "tsdown",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev": "tsdown --watch",
    "ui:dev": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "evals": "tsx src/cli.ts run",
    "ui": "tsx src/cli.ts ui"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "citty": "^0.2.2"
  }
}
